{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "Git Blame",
            "command": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [
                "${env:APPDATA}\\Code\\User\\vscode-tasks-git-blame.sh"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "none"
            },
            "presentation": {
                "echo": false,
                "reveal": "silent",
